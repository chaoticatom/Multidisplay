{
  "name": "multidisplay-pi",
  "version": "0.7.16",
  "private": true,
  "description": "Effect engine, panel driver and control page for Multidisplay, running on a Raspberry Pi.",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "start:mock": "DRIVER=mock SKIP_WIFI_SETUP=1 node src/app.js",
    "release": "node scripts/release.js",
    "test": "eslint --quiet . && node scripts/runTests.js",
    "snapshots:update": "node test/snapshots.test.js --update",
    "lint": "eslint ."
  },
  "dependencies": {
    "jimp": "^1.6.1",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "rpi-led-matrix": "^1.15.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.12.0"
  }
}
